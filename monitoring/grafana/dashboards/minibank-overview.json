{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Platform Health & Stability (Live via kube-state-metrics)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{namespace=\"minibank\", phase=\"Running\"})",
          "legendFormat": "Running Pods",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Running Pods",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"minibank\"}[1h]))",
          "legendFormat": "Restarts (1h)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pod Restarts (Last 1 Hour)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "AZ",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" }
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "count by (app, zone) (kube_pod_info{namespace=\"minibank\"} * on(node) group_left(zone) label_replace(kube_node_labels{label_topology_kubernetes_io_zone!=\"\"}, \"zone\", \"$1\", \"label_topology_kubernetes_io_zone\", \"(.*)\"))",
          "legendFormat": "{{ app }} ({{ zone }})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Multi-AZ Pod Distribution (Topology Spread)",
      "type": "barchart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "Resource Utilization (Live via cAdvisor / kubelet)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Cores",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"minibank\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }} CPU",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU Usage per Pod",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Memory",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"minibank\", container!=\"\"}) by (pod)",
          "legendFormat": "{{ pod }} Memory",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory Working Set per Pod",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 8,
      "title": "Application Traffic & HTTP Golden Signals (Scaffolded — Populates once app /metrics lands)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "NOTE: Depends on prometheus-fastapi-instrumentator or prometheus_client in app-repo exposing 'http_requests_total'. Will populate automatically once app images include instrumentation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Req/sec",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"minibank\"}[5m])) by (app)",
          "legendFormat": "{{ app }} (RPS)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate (RPS) per Microservice [Waiting on App /metrics]",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "NOTE: Depends on app /metrics. Displays percentage of requests resulting in HTTP 5xx errors.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Error Rate %",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{namespace=\"minibank\", status=~\"5..\"}[5m])) by (app) / sum(rate(http_requests_total{namespace=\"minibank\"}[5m])) by (app)",
          "legendFormat": "{{ app }} 5xx %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Error Rate % [Waiting on App /metrics]",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["minibank", "overview", "platform"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "utc",
  "title": "MiniBank — Platform Overview",
  "uid": "minibank-platform-overview",
  "version": 1
}
