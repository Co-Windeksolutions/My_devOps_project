apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-credentials
  namespace: minibank
type: Opaque
stringData:
  # Key name required by bitnami/rabbitmq when using existingPasswordSecret.
  # The chart reads 'rabbitmq-password' for the application user password
  # and 'rabbitmq-erlang-cookie' for cluster node authentication.
  # Both must be present or the StatefulSet pod will not start.
  rabbitmq-password: "CHANGE_ME_RABBITMQ_PASSWORD"
  rabbitmq-erlang-cookie: "CHANGE_ME_ERLANG_COOKIE_RANDOM_STRING"
