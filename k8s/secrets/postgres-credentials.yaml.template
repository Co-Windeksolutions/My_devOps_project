apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: minibank
type: Opaque
stringData:
  # Key name required by bitnami/postgresql when using existingSecret.
  # The chart reads 'password' for the admin user and 'postgres-password'
  # for the postgres superuser. Both must be set.
  password: "CHANGE_ME_POSTGRES_PASSWORD"
  postgres-password: "CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD"
