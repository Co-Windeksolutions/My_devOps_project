{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Business Ledger Performance (Scaffolded — Populates once app /metrics lands)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "NOTE: Depends on custom counter 'wallet_transfers_total' emitted by Wallet/Ledger service. Will populate once app instrumentation is added.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(increase(wallet_transfers_total[1h]))",
          "legendFormat": "Transfers (1h)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Total Transfers Processed (1h) [Waiting on App /metrics]",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "NOTE: Percentage of fund transfers completed successfully vs failed due to ledger/balance/system errors.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(wallet_transfers_total{status=\"success\"}[5m])) / sum(rate(wallet_transfers_total[5m]))",
          "legendFormat": "Success Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Transfer Success Rate % [Waiting on App /metrics]",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "NOTE: Financial transfer throughput in operations per second, broken down by success/failure status.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Transfers/sec",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(wallet_transfers_total[1m])) by (status)",
          "legendFormat": "{{ status }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Transfer Throughput (TPS) [Waiting on App /metrics]",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Messaging Pipeline Health (RabbitMQ Integration)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "Rate of transfer events published to RabbitMQ exchange vs consumed by Notification service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Messages/sec",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "mps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(rabbitmq_queue_messages_published_total{queue=\"notifications.events\"}[5m])",
          "legendFormat": "Published (Wallet/Ledger)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rate(rabbitmq_queue_messages_delivered_total{queue=\"notifications.events\"}[5m])",
          "legendFormat": "Delivered (Notification)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "RabbitMQ Event Flow: Publish vs Delivery",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Total pending messages in notifications.events queue. Growth indicates consumer lag.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Messages",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "rabbitmq_queue_messages_ready{queue=\"notifications.events\"}",
          "legendFormat": "Pending Queue Depth",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Notification Queue Backlog Depth",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 8,
      "title": "Ledger Pod Infrastructure (Live via cAdvisor)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "CPU Cores",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 9,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"minibank\", pod=~\"wallet-ledger-service-.*\", container=\"wallet-ledger-service\"}[5m])) by (pod)",
          "legendFormat": "{{ pod }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Wallet/Ledger Pod CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Bytes",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 10,
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"minibank\", pod=~\"wallet-ledger-service-.*\", container=\"wallet-ledger-service\"}) by (pod)",
          "legendFormat": "{{ pod }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Wallet/Ledger Pod Memory Working Set",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["minibank", "wallet", "ledger", "business"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "utc",
  "title": "MiniBank — Wallet/Ledger Business Metrics",
  "uid": "minibank-wallet-ledger-metrics",
  "version": 1
}
